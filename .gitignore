# ============================================================
# 账号凭证 / 私有数据 —— 绝对不要提交
# ============================================================
*.session
*.session-journal
tg_session*
tg_cleaner_config.json
# 单账号时代的文件名（v1.1.x）
tg_stats_cache.json
tg_role_cache.json
# 多账号（v1.2.0 起）：tg_stats_cache_<key>.json / tg_role_cache_<key>.json
tg_stats_cache*.json
tg_role_cache*.json

# 运行时产生的日志（无斜杠的写法在任意层级都匹配，dist/ 下的也一并拦掉）
tg_selftest.log
tg_crash.log
# v1.3.1 起：界面日志同时落盘到这里（含会话名，属于本机数据，不入库）
tg_leave_log.txt
tg_leave_log.txt.1

# dist 目录里除可执行文件外的运行时数据（含 api_id / api_hash / 手机号 / 登录态）
dist/*.json
dist/*.session

# ============================================================
# 构建产物
# ============================================================
build/
_dist_build/
dist/*.exe.rej
_build_done/
_build_done_*/
_obsolete/
*.spec.bak
*.pyc
__pycache__/
__pycache__/**
*.egg-info/
.venv/
venv/
env/

# ============================================================
# 内部工作记录（含私人频道名与内部笔记，不对外发布）
# ============================================================
.workbuddy/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
tkinter_missing.log
